rules_version = '2';
// TASLAK: Playground'da test etmeden yayınlama. Admin e-postasını kendininkiyle değiştir.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'yakupt196@gmail.com'; }

    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data','updated'])
        && request.resource.size() < 900000;
    }
    match /nicks/{n} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /gifts/{g} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed']);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
